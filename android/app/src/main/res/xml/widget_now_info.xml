<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0 on purpose. Android's floor is 30 minutes, which is
     both too slow to be useful and a needless wakeup: the app pushes an update
     the moment Now changes, and onUpdate still runs when a widget is added or
     the device reboots. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_now"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
