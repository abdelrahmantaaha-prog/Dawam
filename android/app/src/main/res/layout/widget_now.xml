<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately plain: widgets are drawn by the launcher's process via
     RemoteViews, which supports only a fixed set of views and attributes.
     No custom fonts, no gradients, no ConstraintLayout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_eyebrow"
        android:textColor="#8CA79A"
        android:textSize="10sp"
        android:letterSpacing="0.09"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#12241D"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#3E8A6C"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_upcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="#6B8577"
        android:textSize="11sp"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
