<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Home-screen widget. exported=true is required: the launcher is a
             different process and has to be able to bind it. It carries no
             data of its own — it renders a summary the app pushes in. -->
        <receiver
            android:name=".RhythmWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_info" />
        </receiver>

        <!-- The receiver `adb shell dpm set-device-owner` points at.

             It carries no policy and does nothing on its own. Device ownership
             is here for exactly one capability: lock task mode that cannot be
             escaped by holding Back and Overview, which is what makes the Now
             lock mean something on a phone rather than on a laptop. Declaring
             this does not make Dawam a device owner and has no effect at all
             on an ordinary install — the adb command is the only route in, on
             a device with no accounts on it yet. See RhythmLockPlugin. -->
        <receiver
            android:name=".RhythmDeviceAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Tera, the secretary. Her face over other apps is a foreground
             service (a window drawn over other apps belongs to a process, and
             only a foreground service keeps it alive while it is on screen);
             special use, because no other foreground-service type describes
             "an assistant that appears when you have gone quiet". -->
        <service
            android:name=".tera.TeraHeadService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating assistant: shows the user's own reminders and check-ins over other apps until dismissed." />
        </service>

        <!-- Her alarm, the phone restarting, and her notification buttons.
             Not exported: only the system's own broadcasts and her own
             pending intents ever reach it. -->
        <receiver
            android:name=".tera.TeraReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Dictation. The WebView has no SpeechRecognition, so the assistant records
      a clip and has it transcribed; that is plain getUserMedia, and Capacitor's
      BridgeWebChromeClient turns the page's request into an Android runtime
      prompt — but only for permissions the app actually declares. Without
      these two it denies without ever asking, which looks exactly like a
      broken microphone button.

      MODIFY_AUDIO_SETTINGS rides along because Capacitor requests the pair
      together; both are asked for at the moment the mic is first tapped, never
      at launch. No audio is stored: the clip lives in memory for the length of
      one request and is released with the stream.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Exact alarms. The local-notifications plugin contributes POST_NOTIFICATIONS,
      WAKE_LOCK and RECEIVE_BOOT_COMPLETED, but NOT these — and without them
      Android 12+ refuses setExactAndAllowWhileIdle, so a timed-task reminder
      would drift or silently not fire.

      SCHEDULE_EXACT_ALARM covers API 31-32 (user-revocable under
      Settings > Apps > Alarms & reminders). USE_EXACT_ALARM covers API 33+ and
      is auto-granted, but Google Play restricts it to apps whose core purpose
      is alarms/reminders — fine for personal or sideloaded builds; if you ever
      publish, expect to justify it or drop back to SCHEDULE_EXACT_ALARM only.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      Tera. SYSTEM_ALERT_WINDOW is the floating face over other apps — granted
      by the person under "Display over other apps", asked for from Tera's
      settings, never at launch. Without it she falls back to notifications.
      The foreground-service pair keeps that face's process alive while it is
      on screen. RECEIVE_BOOT_COMPLETED re-arms her alarm after a restart (the
      notifications plugin declares it too; saying so here keeps Tera's needs
      in one place).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
