<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Home-screen widget. exported=true is required: the launcher is a
             different process and has to be able to bind it. It carries no
             data of its own — it renders a summary the app pushes in. -->
        <receiver
            android:name=".RhythmWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Exact alarms. The local-notifications plugin contributes POST_NOTIFICATIONS,
      WAKE_LOCK and RECEIVE_BOOT_COMPLETED, but NOT these — and without them
      Android 12+ refuses setExactAndAllowWhileIdle, so a timed-task reminder
      would drift or silently not fire.

      SCHEDULE_EXACT_ALARM covers API 31-32 (user-revocable under
      Settings > Apps > Alarms & reminders). USE_EXACT_ALARM covers API 33+ and
      is auto-granted, but Google Play restricts it to apps whose core purpose
      is alarms/reminders — fine for personal or sideloaded builds; if you ever
      publish, expect to justify it or drop back to SCHEDULE_EXACT_ALARM only.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>
