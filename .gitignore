# dependencies
node_modules/

# build output
dist/
dist-ssr/

# Android build artifacts (the android/ project itself IS committed, so the
# manifest edits and Gradle config survive; only generated output is ignored)
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/capacitor-cordova-android-plugins/
*.apk
*.aab

# signing key material — never commit
*.keystore
*.jks

# local dev tooling
.claude/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# env
.env
.env.local
.env.*.local
