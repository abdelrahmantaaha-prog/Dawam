{
  "name": "dawam",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "android:sync": "vite build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:remote": "npm run android:sync && node scripts/remote-config.mjs",
    "ios:fetch": "node scripts/fetch-ipa.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && npm --prefix desktop start",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:install": "npm --prefix desktop install",
    "desktop:smoke": "npm run desktop:build && npm --prefix desktop run smoke",
    "desktop:dist": "npm run desktop:build && npm --prefix desktop run dist",
    "desktop:pack": "npm run desktop:build && npm --prefix desktop run dist:dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@auth/express": "^0.10.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@neondatabase/serverless": "^1.1.0",
    "express": "^4.22.2",
    "lucide-react": "0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
