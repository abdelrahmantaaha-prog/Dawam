{
  "name": "rhythm-desktop",
  "productName": "Rhythm",
  "version": "1.12.0",
  "private": true,
  "description": "Rhythm on the desktop — the planner window plus the focus suite (the app formerly known as Anchor).",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node smoke.mjs",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "author": "Abdelrahman Taha",
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.abdelrahmantaha.rhythm",
    "productName": "Rhythm",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/*.ps1",
      "assets/models/**",
      "node_modules/@mediapipe/**"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Rhythm-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Rhythm-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rhythm",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
